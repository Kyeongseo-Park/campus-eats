// Prisma schema for CampusEats ("학식 말고 뭐 먹지?")
// Source of truth: docs/01_PRD/PRD_v2.md, section 11 (ERD).
// Note: `Favorite` is not in the PRD's ERD table but is required to implement
// the Must-have "즐겨찾기" feature (section 5/9), so it is added here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  nickname  String   @unique
  /// "user" | "admin" — defaults to user; admin is granted by manually updating this column.
  role      String   @default("user")
  createdAt DateTime @default(now()) @map("created_at")

  accounts           Account[]
  reviews            Review[]
  restaurantRequests RestaurantRequest[]
  favorites          Favorite[]
  reviewHelpfulVotes ReviewHelpful[]

  @@map("users")
}

model Account {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  /// "kakao" | "google"
  provider String
  /// 제공자가 발급한 고유 회원 식별자 (카카오: 회원번호, 구글: sub). 이메일/프로필은
  /// 받아오지 않으므로 이 값이 계정을 식별하는 유일한 근거다.
  providerAccountId String @map("provider_account_id")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Restaurant {
  id        String  @id @default(uuid()) @db.Uuid
  /// 카카오 로컬 API의 place id. CSV/API 기반 데이터 임포트를 재실행해도 같은 식당을
  /// 덮어쓰도록 매칭하는 키 — 수기로 등록한(관리자 도구) 식당은 값이 없다.
  kakaoId   String? @unique @map("kakao_id")
  name      String
  /// 한식 | 중식 | 일식 | 양식 | 분식 | 카페 | 패스트푸드 | 기타
  category  String
  /// 정문 | 상대 | 예대 | 후문 | 공대쪽문
  zone      String
  address   String
  phone     String?
  latitude  Float
  longitude Float
  /// Lowest menu price; drives the price-range filter/sort. 메뉴 정보가 없으면 null
  /// ("가격 정보 없음")이며, 가격대 필터에서는 자동으로 제외된다.
  minPrice  Int?    @map("min_price")

  partnershipStartDate DateTime? @map("partnership_start_date") @db.Date
  partnershipEndDate   DateTime? @map("partnership_end_date") @db.Date
  partnershipInfo      String?   @map("partnership_info")

  /// 카카오맵 "영업정보"에서 수집한 원본 텍스트(재파싱/디버깅용). 수집 안 된 식당은 null.
  businessHoursRaw String? @map("business_hours_raw")
  /// 요일별 영업시간(BusinessHours, src/lib/business-hours.ts 참고). 파싱 실패/미수집 시 null.
  businessHours    Json?   @map("business_hours")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  menus     Menu[]
  reviews   Review[]
  favorites Favorite[]

  @@index([zone])
  @@index([category])
  @@index([minPrice])
  @@index([partnershipStartDate, partnershipEndDate])
  @@map("restaurants")
}

model Menu {
  id           String @id @default(uuid()) @db.Uuid
  restaurantId String @map("restaurant_id") @db.Uuid
  name         String
  price        Int

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("menus")
}

model Review {
  id           String @id @default(uuid()) @db.Uuid
  userId       String @map("user_id") @db.Uuid
  restaurantId String @map("restaurant_id") @db.Uuid
  /// 1~5 정수
  rating       Int
  content      String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  images       ReviewImage[]
  helpfulVotes ReviewHelpful[]

  @@index([restaurantId])
  @@index([userId])
  @@map("reviews")
}

model ReviewImage {
  id       String @id @default(uuid()) @db.Uuid
  reviewId String @map("review_id") @db.Uuid
  url      String
  /// 리뷰 내 표시 순서 (0부터)
  order    Int    @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_images")
}

model RestaurantRequest {
  id             String  @id @default(uuid()) @db.Uuid
  userId         String  @map("user_id") @db.Uuid
  restaurantName String  @map("restaurant_name")
  address        String
  /// 제보자 입력값, 관리자 승인 시 수정 가능
  category       String
  /// 선택 입력
  menuInfo       String? @map("menu_info")
  /// 대기 | 승인 | 반려
  status         String  @default("대기")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("restaurant_requests")
}

model ReviewHelpful {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  reviewId  String   @map("review_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewId])
  @@map("review_helpfuls")
}

model Favorite {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
  @@map("favorites")
}
